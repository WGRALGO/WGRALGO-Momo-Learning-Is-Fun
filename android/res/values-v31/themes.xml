<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/purple</item>
        <item name="android:colorBackground">@color/purple</item>
        <item name="android:statusBarColor">@color/purple</item>
        <item name="android:navigationBarColor">@color/purple</item>
        <item name="android:colorAccent">@color/gold</item>
        <!-- Android 12+: plain purple (no small circled icon), then the page shows the logo big -->
        <item name="android:windowSplashScreenBackground">@color/purple</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_none</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/purple</item>
    </style>
</resources>
